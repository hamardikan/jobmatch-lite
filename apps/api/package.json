    "elysia": "^1.2.0",
    "mammoth": "^1.8.0",
    "postgres": "^3.4.7",
    "unpdf": "^0.12.0"
  },
    "devDependencies": {
    "@testcontainers/postgresql": "^11.10.0",
    "@types/bun": "latest",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "testcontainers": "^11.10.0",
    "typescript": "^5.7.0"
