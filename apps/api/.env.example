# Backend Environment Variables

# OpenRouter API Key (required)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Frontend URL for CORS (optional, defaults to http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Port (optional, defaults to 3001)
PORT=3001

# Database Configuration
# Local development: postgresql://jobmatch:jobmatch@localhost:5432/jobmatch
# Production (Neon): postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://jobmatch:jobmatch@localhost:5432/jobmatch

# Better-Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth (optional, for social login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
