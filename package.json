{
  "name": "jobmatch-lite",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "type-check": "turbo type-check",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "e2e": "bunx --bun playwright test --config=e2e/playwright.config.ts --project=chromium",
    "e2e:ui": "bunx --bun playwright test --config=e2e/playwright.config.ts --ui",
    "e2e:headed": "bunx --bun playwright test --config=e2e/playwright.config.ts --headed",
    "e2e:report": "bunx --bun playwright show-report e2e/playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testcontainers/postgresql": "^11.11.0",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "postgres": "^3.4.7",
    "testcontainers": "^11.11.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
